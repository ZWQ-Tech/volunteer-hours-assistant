# 复制本文件为 .env 并填入你自己的 Key（.env 已被 .gitignore 排除，不会被提交）

# 阿里云百炼 DashScope API Key（https://bailian.console.aliyun.com/ 获取）
DASHSCOPE_API_KEY=sk-your_api_key_here

# 使用的通义千问模型（可选，默认 qwen-plus）
DASHSCOPE_MODEL=qwen-plus

# OpenAI 兼容接口地址（可选，默认为百炼官方地址）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
